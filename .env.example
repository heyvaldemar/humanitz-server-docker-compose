# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# The admin password players type in game to become admin. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
HUMANITZ_ADMIN_PASSWORD=
# RCON's password. RCON is published nowhere: scripts/rcon.sh, status.sh,
# refresh.sh and backup.sh reach it from inside the container. Generate one the
# same way, different from the admin password.
HUMANITZ_RCON_PASSWORD=

# ---------------------------------------------------------------- the server
# The name players see. Not empty, and no " $ ` or \ in it: LinuxGSM pastes it
# into a shell line, and scripts/start.sh refuses rather than guess.
HUMANITZ_SERVER_NAME=HumanitZ Server
# Empty: anyone who finds the server can join.
HUMANITZ_SERVER_PASSWORD=
HUMANITZ_MAX_PLAYERS=16

# ---------------------------------------------------------------- networking
# Published under the numbers the server binds and advertises, never
# translated. Change one here and both sides move with it.
HUMANITZ_SERVER_PORT=7777
HUMANITZ_SERVER_QUERY_PORT=27015

HUMANITZ_SERVER_TIMEZONE=UTC

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# HUMANITZ_SERVER_IMAGE_VERSION=hz@sha256:...
# HUMANITZ_SERVER_IMAGE_TAG=gameservermanagers/gameserver:hz
#
# An Unreal Engine 4 open world: 8 GB is the usual guidance, 4 GB the least.
# HUMANITZ_SERVER_MEMORY_LIMIT=8g
# HUMANITZ_SERVER_CPU_LIMIT=4.0
# HUMANITZ_SERVER_MEMORY_RESERVATION=2g
# HUMANITZ_SERVER_CPU_RESERVATION=1.0
#
# The first start downloads the game (1.4 GB; 78 seconds on a CI runner).
# HUMANITZ_SERVER_START_PERIOD=30m
# The world is saved on the way out.
# HUMANITZ_SERVER_STOP_GRACE_PERIOD=2m
# HUMANITZ_SERVER_LOG_MAX_SIZE=10m
# HUMANITZ_SERVER_LOG_MAX_FILE=3
#
# Backups (scripts/backup.sh): where archives go and how many are kept. The
# archives hold the settings, passwords included, and are written mode 600.
# HUMANITZ_BACKUP_DIR=./backups
# HUMANITZ_BACKUP_KEEP=14
